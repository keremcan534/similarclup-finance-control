# Similarclup Finance Control — örnek ortam dosyası. Gerçek sır içermez.
# Kopyalayın: .env  (git'e eklenmez)

FC_PORT=4300
# Sunucu yalnız bu makineden erişilsin. Ağa açacaksanız önüne HTTPS ters vekil koyun.
FC_HOST=127.0.0.1
FC_DATA_DIR=data
FC_DB_FILE=finance.db
# 1 yapılırsa giriş ekranı atlanır ve panel süper yönetici olarak açılır.
# Yalnız yerel geliştirme içindir; FC_HOST=127.0.0.1 değilse sunucu başlamaz.
FC_NO_LOGIN=0
# HTTPS arkasında çalışırken 1 yapın (oturum çerezi Secure olur).
FC_COOKIE_SECURE=0

# İlk çalıştırmada oluşturulacak süper yönetici. Boş bırakılırsa e-posta ve parola rastgele
# üretilir ve data/giris-bilgileri.txt dosyasına yazılır.
FC_ADMIN_EMAIL=
FC_ADMIN_PASSWORD=
